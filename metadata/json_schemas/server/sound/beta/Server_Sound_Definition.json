{
   "title": "Server Sound Definition",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/server/sound/beta/Server%20Sound%20Definition.json",
   "x-format-version": "beta",
   "type": "object",
   "properties": {
      "broadcast_range": {
         "type": "number",
         "x-underlying-type": "float",
         "x-ordinal-index": 4
      },
      "duration_info": {
         "$ref": "./Server%20Sound%20Duration%20Info.json",
         "x-ordinal-index": 1
      },
      "music_info": {
         "$ref": "./Server%20Sound%20Music%20Info.json",
         "x-ordinal-index": 2
      },
      "sound_event_name": {
         "type": "string",
         "x-ordinal-index": 0,
         "pattern": "^\\S+$",
         "x-regex-flags": "ECMAScript,icase"
      },
      "tags": {
         "type": "object",
         "propertyNames": {
            "type": "string",
            "pattern": "^\\S+$"
         },
         "additionalProperties": {
            "$ref": "./Server%20Sound%20Tag%20Value%20List.json"
         },
         "x-ordinal-index": 3
      }
   },
   "required": [
      "sound_event_name"
   ]
}