{
   "title": "Detection Rule",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/server/block/1.26.20/Detection%20Rule.json",
   "x-format-version": "1.26.20",
   "type": "object",
   "properties": {
      "can_contain_liquid": {
         "type": "boolean",
