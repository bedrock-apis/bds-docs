{
   "title": "Tick",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/server/block/1.26.20/Tick.json",
   "x-format-version": "1.26.20",
   "type": "object",
   "properties": {
      "interval_range": {
         "type": "array",
         "items": {
            "type": "integer",
            "x-underlying-type": "uint32",
            "minimum": 0
         },
         "x-ordinal-index": 0,
         "minItems": 2,
         "maxItems": 2,
         "x-runtime-constraint-description": "The first value must be equal or lower than the second value"
      },
      "looping": {
         "type": "boolean",
         "default": true,
         "x-underlying-type": "boolean",
         "x-ordinal-index": 1
      }
   },
   "required": [
      "interval_range"
   ]
}