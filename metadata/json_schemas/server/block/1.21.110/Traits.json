{
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "3258847033",
   "x-format-version": "1.21.110",
   "definitions": {
      "517105782": {
         "title": "compound_proxy",
         "oneOf": [
            {
               "type": "integer"
            },
            {
               "type": "string"
            },
            {
               "type": "boolean"
            }
         ]
      },
      "2036565844": {
         "title": "Connection",
         "type": "object",
         "properties": {
            "enabled_states": {
               "type": "array",
               "items": {
                  "title": "Connection::EnabledState",
                  "type": "string",
                  "enum": [
                     "minecraft:cardinal_connections"
                  ]
               },
               "minProperties": 1
            }
         },
         "required": [
            "enabled_states"
         ]
      },
      "2651415152": {
         "title": "Placement Position",
         "type": "object",
         "properties": {
            "enabled_states": {
               "type": "array",
               "items": {
                  "type": "string",
                  "pattern": "^(minecraft:block_face|minecraft:vertical_half)$"
               },
               "minItems": 1,
               "maxItems": 2
            }
         },
         "required": [
            "enabled_states"
         ]
      },
      "2770948419": {
         "title": "BlockDescriptorProxy",
         "type": "object",
         "properties": {
            "name": {
               "type": "string",
               "default": ""
            },
            "states": {
               "type": "object",
               "additionalProperties": {
                  "$ref": "#/definitions/517105782"
               },
               "default": {}
            },
            "tags": {
               "type": "string",
               "default": ""
            }
         }
      },
      "2794205495": {
         "title": "Block Descriptor",
         "oneOf": [
            {
               "$ref": "#/definitions/2770948419",
               "x-runtime-constraint-description": "Check that a valid block name or expression is provided, and in the latter case verify that there are no block states as well"
            },
            {
               "type": "string",
               "minLength": 1
            },
            {
               "$ref": "#/definitions/2770948419",
               "x-runtime-constraint-description": "Check that a valid block name or expression is provided, and in the latter case verify that there are no block states as well"
            }
         ]
      },
      "3773031244": {
         "title": "Placement Direction",
         "type": "object",
         "properties": {
            "blocks_to_corner_with": {
               "type": "array",
               "default": [],
               "items": {
                  "$ref": "#/definitions/2794205495"
               }
            },
            "enabled_states": {
               "type": "array",
               "items": {
                  "type": "string",
                  "pattern": "^(minecraft:cardinal_direction|minecraft:facing_direction|minecraft:corner_and_cardinal_direction)$"
               },
               "minItems": 1,
               "maxItems": 3
            },
            "y_rotation_offset": {
               "type": "number",
               "multipleOf": 90,
               "minimum": 0,
               "maximum": 360
            }
         },
         "required": [
            "enabled_states"
         ]
      }
   },
   "title": "Traits",
   "type": "object",
   "properties": {
      "minecraft:connection": {
         "default": {
            "enabled_states": []
         },
         "$ref": "#/definitions/2036565844"
      },
      "minecraft:placement_direction": {
         "default": {
            "enabled_states": [],
            "y_rotation_offset": null,
            "blocks_to_corner_with": []
         },
         "$ref": "#/definitions/3773031244",
         "x-runtime-constraint-description": "\"y_rotation_offset\" can only be used when \"minecraft:cardinal_direction\" and/or \"minecraft:facing_direction\" are enabled in \"enabled_states\". and \"blocks_to_corner_with\" can only be used when \"minecraft:corner_and_cardinal_direction\" is enabled in \"enabled_states\"."
      },
      "minecraft:placement_position": {
         "default": {
            "enabled_states": []
         },
         "$ref": "#/definitions/2651415152"
      }
   }
}