{
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "3639862792",
   "x-format-version": "1.21.110",
   "definitions": {
      "595521793": {
         "title": "Placement Direction",
         "type": "object",
         "properties": {
            "blocks_to_corner_with": {
               "type": "array",
               "default": [],
               "items": {
                  "$ref": "#/definitions/3093766462"
               }
            },
            "enabled_states": {
               "type": "array",
               "items": {
                  "title": "Placement Position Enabled State",
                  "type": "string",
                  "enum": [
                     "minecraft:cardinal_direction",
                     "minecraft:corner_and_cardinal_direction",
                     "minecraft:facing_direction"
                  ]
               },
               "minItems": 1
            },
            "y_rotation_offset": {
               "type": "number",
               "multipleOf": 90,
               "minimum": 0,
               "maximum": 360
            }
         },
         "required": [
            "enabled_states"
         ]
      },
      "855125494": {
         "title": "BlockDescriptorProxy",
         "type": "object",
         "properties": {
            "name": {
               "type": "string",
               "default": ""
            },
            "states": {
               "type": "object",
               "additionalProperties": {
                  "$ref": "#/definitions/2565245911"
               },
               "default": {}
            },
            "tags": {
               "type": "string",
               "default": ""
            }
         }
      },
      "1463434457": {
         "title": "Connection",
         "type": "object",
         "properties": {
            "enabled_states": {
               "type": "array",
               "items": {
                  "title": "Connection Enabled State",
                  "type": "string",
                  "enum": [
                     "minecraft:cardinal_connections"
                  ]
               },
               "minItems": 1
            }
         },
         "required": [
            "enabled_states"
         ]
      },
      "2125795619": {
         "title": "Placement Position",
         "type": "object",
         "properties": {
            "enabled_states": {
               "type": "array",
               "items": {
                  "title": "Placement Position Enabled State",
                  "type": "string",
                  "enum": [
                     "minecraft:block_face",
                     "minecraft:vertical_half"
                  ]
               },
               "minItems": 1
            }
         },
         "required": [
            "enabled_states"
         ]
      },
      "2318834135": {
         "title": "Multi Block",
         "type": "object",
         "properties": {
            "direction": {
               "title": "Facing",
               "type": "string",
               "enum": [
                  "down",
                  "up"
               ]
            },
            "enabled_states": {
               "type": "array",
               "items": {
                  "title": "Multi Block Enabled State",
                  "type": "string",
                  "enum": [
                     "minecraft:multi_block_part"
                  ]
               },
               "minItems": 1
            },
            "parts": {
               "type": "integer",
               "default": 2,
               "minimum": 2,
               "maximum": 4
            }
         },
         "required": [
            "direction",
            "enabled_states"
         ]
      },
      "2565245911": {
         "title": "compound_proxy",
         "oneOf": [
            {
               "type": "integer"
            },
            {
               "type": "string"
            },
            {
               "type": "boolean"
            }
         ]
      },
      "3093766462": {
         "title": "Block Descriptor",
         "oneOf": [
            {
               "$ref": "#/definitions/855125494",
               "x-runtime-constraint-description": "Check that a valid block name or expression is provided, and in the latter case verify that there are no block states as well"
            },
            {
               "type": "string",
               "minLength": 1
            },
            {
               "$ref": "#/definitions/855125494",
               "x-runtime-constraint-description": "Check that a valid block name or expression is provided, and in the latter case verify that there are no block states as well"
            }
         ]
      }
   },
   "title": "Traits",
   "type": "object",
   "properties": {
      "minecraft:connection": {
         "default": {
            "enabled_states": []
         },
         "$ref": "#/definitions/1463434457"
      },
      "minecraft:multi_block": {
         "default": {
            "parts": 2,
            "enabled_states": [],
            "direction": "up"
         },
         "$ref": "#/definitions/2318834135"
      },
      "minecraft:placement_direction": {
         "default": {
            "enabled_states": [],
            "y_rotation_offset": null,
            "blocks_to_corner_with": []
         },
         "$ref": "#/definitions/595521793",
         "x-runtime-constraint-description": "\"y_rotation_offset\" can only be used when \"minecraft:cardinal_direction\" and/or \"minecraft:facing_direction\" are enabled in \"enabled_states\". and \"blocks_to_corner_with\" can only be used when \"minecraft:corner_and_cardinal_direction\" is enabled in \"enabled_states\"."
      },
      "minecraft:placement_position": {
         "default": {
            "enabled_states": []
         },
         "$ref": "#/definitions/2125795619"
      }
   }
}