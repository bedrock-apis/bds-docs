{
   "title": "NoiseBlockSpecifier",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/server/biome/1.26.30/NoiseBlockSpecifier.json",
   "x-format-version": "1.26.30",
   "type": "object",
   "properties": {
      "block": {
         "$ref": "../../../client_server/common/1.21.20/Block%20Specifier.json",
         "x-ordinal-index": 3
      },
      "noise": {
         "type": "string",
         "default": "",
