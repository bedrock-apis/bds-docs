   "x-format-version": "1.26.0",
   "definitions": {
      "546677968": {
         "title": "CameraSplineDefinition",
         "type": "object",
         "properties": {
            "control_points": {
               "type": "array",
               "items": {
                  "$ref": "#/definitions/1274567168"
               }
            },
            "name": {
               "type": "string",
               "pattern": "^\\w+:\\w+$"
            },
            "progress_key_frames": {
               "type": "array",
               "items": {
                  "$ref": "#/definitions/3914468974"
               }
            },
            "rotation_key_frames": {
               "type": "array",
               "items": {
                  "$ref": "#/definitions/790401607"
               }
            },
            "spline_type": {
               "type": "string",
               "default": "catmullrom",
               "pattern": "^(?:catmullrom|linear)$"
            },
            "total_time": {
               "type": "number",
               "minimum": 0
            }
         },
         "required": [
            "control_points",
            "name",
            "progress_key_frames",
            "rotation_key_frames",
            "total_time"
         ]
      },
