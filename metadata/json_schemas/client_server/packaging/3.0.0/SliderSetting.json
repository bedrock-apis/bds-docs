{
   "title": "SliderSetting",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/client_server/packaging/3.0.0/SliderSetting.json",
   "x-format-version": "3.0.0",
   "type": "object",
   "properties": {
      "default": {
         "type": "number",
         "x-underlying-type": "float",
         "x-ordinal-index": 6
      },
      "max": {
         "type": "number",
         "x-underlying-type": "float",
         "x-ordinal-index": 4
      },
      "min": {
         "type": "number",
         "x-underlying-type": "float",
         "x-ordinal-index": 3
      },
      "name": {
         "type": "string",
         "x-ordinal-index": 1,
         "pattern": "^(?:(?!^(minecraft):).)+:(?:.)+$",
         "x-regex-flags": "ECMAScript,icase"
      },
      "step": {
         "type": "number",
         "x-underlying-type": "float",
         "x-ordinal-index": 5,
         "exclusiveMinimum": 0
      },
      "text": {
         "type": "string",
         "x-ordinal-index": 2
      },
      "type": {
         "$ref": "./SettingType.json",
         "x-underlying-type": "uint8",
         "x-ordinal-index": 0
      }
   },
   "required": [
      "default",
      "max",
      "min",
      "name",
      "step",
      "text",
      "type"
   ]
}