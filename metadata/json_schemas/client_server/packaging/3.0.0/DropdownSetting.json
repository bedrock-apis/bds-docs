{
   "title": "DropdownSetting",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/client_server/packaging/3.0.0/DropdownSetting.json",
   "x-format-version": "3.0.0",
   "type": "object",
   "properties": {
      "default": {
         "type": "string",
         "x-ordinal-index": 4,
         "minLength": 1
      },
      "name": {
         "type": "string",
         "x-ordinal-index": 1,
         "pattern": "^(?:(?!^(minecraft):).)+:(?:.)+$",
         "x-regex-flags": "ECMAScript,icase"
      },
      "options": {
         "type": "array",
         "items": {
            "$ref": "./DropdownOption.json"
         },
         "x-ordinal-index": 3,
         "minItems": 2,
         "maxItems": 20
      },
      "text": {
         "type": "string",
         "x-ordinal-index": 2
      },
      "type": {
         "$ref": "./SettingType.json",
         "x-underlying-type": "uint8",
         "x-ordinal-index": 0
      }
   },
   "required": [
      "default",
      "name",
      "options",
      "text",
      "type"
   ]
}