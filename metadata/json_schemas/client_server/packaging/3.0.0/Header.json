{
   "title": "Header",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/client_server/packaging/3.0.0/Header.json",
   "x-format-version": "3.0.0",
   "type": "object",
   "properties": {
      "allow_random_seed": {
         "type": "boolean",
         "x-underlying-type": "boolean",
         "x-ordinal-index": 8
      },
      "base_game_version": {
         "type": "string",
         "x-ordinal-index": 5
      },
      "description": {
         "type": "string",
         "x-ordinal-index": 1
      },
      "lock_template_options": {
         "type": "boolean",
         "x-underlying-type": "boolean",
         "x-ordinal-index": 9
      },
      "min_engine_version": {
         "type": "string",
         "x-ordinal-index": 4
      },
      "name": {
         "type": "string",
         "x-ordinal-index": 0,
         "minLength": 1
      },
      "pack_optimization_version": {
         "$ref": "./RelaxedSemVersion.json",
         "x-ordinal-index": 10
      },
      "pack_scope": {
         "type": "string",
         "x-ordinal-index": 6
      },
      "platform_locked": {
         "type": "boolean",
         "x-underlying-type": "boolean",
         "x-ordinal-index": 7
      },
      "uuid": {
         "$ref": "./UUID.json",
         "x-ordinal-index": 2,
         "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "version": {
         "$ref": "./SemVersion.json",
         "x-ordinal-index": 3
      }
   },
   "required": [
      "name",
      "uuid",
      "version"
   ]
}