{
   "title": "Atomic Client Entity Description",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/client/entity/beta/Atomic%20Client%20Entity%20Description.json",
   "x-format-version": "beta",
   "type": "object",
   "properties": {
      "animations": {
         "type": "object",
         "additionalProperties": {
            "type": "string"
         },
         "default": {},
         "x-ordinal-index": 4
      },
      "geometry": {
         "type": "object",
         "additionalProperties": {
            "type": "string"
         },
         "default": {},
         "x-ordinal-index": 3
      },
      "identifier": {
         "type": "string",
         "x-ordinal-index": 0,
         "pattern": "^(?:.)+:(?:.)+$",
         "x-regex-flags": "ECMAScript,icase"
      },
      "materials": {
         "type": "object",
         "additionalProperties": {
            "type": "string"
         },
         "default": {},
         "x-ordinal-index": 1
      },
      "particle_effects": {
         "type": "object",
         "additionalProperties": {
            "type": "string"
         },
         "default": {},
         "x-ordinal-index": 5
      },
      "render_controllers": {
         "type": "array",
         "default": [],
         "items": {
            "type": "string"
         },
         "x-ordinal-index": 8
      },
      "scripts": {
         "default": {
            "initialize": [],
            "pre_animation": [],
            "animate": []
         },
         "$ref": "./ScriptDescription.json",
         "x-ordinal-index": 7
      },
      "sound_effects": {
         "type": "object",
         "additionalProperties": {
            "type": "string"
         },
         "default": {},
         "x-ordinal-index": 6
      },
      "textures": {
         "type": "object",
         "additionalProperties": {
            "type": "string"
         },
         "default": {},
         "x-ordinal-index": 2
      }
   },
   "required": [
      "identifier"
   ]
}