{
   "title": "minecraft:ui-style",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "/client/ddui/beta/DataDrivenUI%20UI%20Style.json",
   "x-format-version": "beta",
   "type": "object",
   "properties": {
      "components": {
         "propertyNames": {
            "type": "string",
            "pattern": "^(?!()$)"
         },
         "$ref": "./components.json",
         "x-ordinal-index": 1,
         "minProperties": 1
      },
      "description": {
         "$ref": "./description.json",
         "x-ordinal-index": 0
      }
   },
   "required": [
      "components",
      "description"
   ]
}